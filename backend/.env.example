# Direct Node/worker startup defaults to Docker. npm start selects local; npm run start:docker selects Docker.
# Local execution runs trusted code directly on your machine.
EXECUTION_MODE=docker
QUEUE_MODE=memory
HOST=127.0.0.1
PORT=5001
WORKER_CONCURRENCY=2
CLIENT_ORIGIN=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
MONGODB_URI=mongodb://127.0.0.1:27017/compilerdb
RUNNER_IMAGE=compileit-runner
# To run API and workers separately, set PROCESS_JOBS=false on the API and start npm run worker.
PROCESS_JOBS=true
QUEUE_NAME=compileit-v2
# Defaults: Mongo lease 12 seconds, renewed every second; Bull detects stalled work after lock expiry.
WORKER_LEASE_MS=12000
WORKER_HEARTBEAT_MS=1000
BULL_LOCK_MS=30000
BULL_STALLED_MS=30000
